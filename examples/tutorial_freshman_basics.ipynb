   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 练习4的答案框架\n",
    "def bfs_upstream_limited(G, outlet, max_depth=None):\n",
    "    \"\"\"\n",
    "    带深度限制的 BFS 追溯\n",
    "    \n",
    "    Args:\n",
    "        G: 上游关系图\n",
    "        outlet: 出口河段 ID\n",
    "        max_depth: 最大追溯层数，None 表示不限制\n",
    "    \n",
    "    Returns:\n",
    "        所有上游河段 ID 的集合\n",
    "    \"\"\"\n",
    "    visited = set([outlet])\n",
    "    # 队列中存储 (河段ID, 深度)\n",
    "    queue = deque([(outlet, 0)])\n",
    "    \n",
    "    while queue:\n",
    "        current, depth = queue.popleft()\n",
    "        \n",
    "        # TODO: 如果 max_depth 不是 None，且当前深度达到限制，跳过\n",
    "        # if max_depth is not None and depth >= max_depth:\n",
    "        #     continue\n",
    "        \n",
    "        for upstream in G.get(current, set()):\n",
    "            if upstream not in visited:\n",
    "                visited.add(upstream)\n",
    "                queue.append((upstream, depth + 1))\n",
    "    \n",
    "    return visited\n",
    "\n",
    "# 测试\n",
    "# result = bfs_upstream_limited(G, 105, max_depth=1)\n",
    "# print(f\"只追溯1层: {result}\")"
